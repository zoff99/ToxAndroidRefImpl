    <string name="pref_title_udp_enabled">Enable UDP</string>
    <string name="pref_description_udp_enabled">Use UDP for Tox connections. On mobile this usually means noticeably more data usage. Off by default.\n\nRequires restart.</string>

    <string name="pref_title_force_udp_only">Force UDP only</string>
    <string name="pref_description_force_udp_only">Use only UDP, with no TCP relay fallback. Some contacts may become unreachable. Use only if you know you need it.\n\nRequires restart.</string>

    <string name="pref_title_orbot_enabled">Route traffic through Tor (Orbot)</string>
    <string name="pref_description_orbot_enabled">Send Tox traffic through the Tor network via Orbot (must be installed), hiding your IP from contacts and bootstrap nodes.\n\nRequires restart.</string>

    <string name="pref_title_fps_half">Half framerate</string>
    <string name="pref_description_fps_half">Send video at half the framerate (about 12 instead of 25 fps) to save data and CPU.</string>

    <string name="pref_title_h264_encoder_use_intra_refresh">H264 intra-refresh</string>
    <string name="pref_description_h264_encoder_use_intra_refresh">Use intra-refresh instead of full keyframes for H264 video. Can reduce stutter on weak connections; leave on unless you have video problems.</string>

    <string name="pref_title_start_on_boot">Start on boot</string>
    <string name="pref_description_start_on_boot">Launch TRIfA automatically after the phone boots.\n\nOn Android 10 and newer you must also allow Display over other apps for TRIfA; a dialog explains this when you enable it.</string>

    <string name="pref_title_use_incognito_keyboard2">Incognito keyboard</string>
    <string name="pref_description_use_incognito_keyboard2">Ask the keyboard not to learn or store the words you type. Not all keyboards honor this.</string>

    <string name="pref_title_window_security">Block screenshots</string>
    <string name="pref_description_window_security">Hide TRIfA content from screenshots, screen recording and the recent-apps preview (Android FLAG_SECURE).</string>

    <string name="pref_title_message_paging_num_msgs_per_page">Messages loaded per chat</string>
    <string name="pref_description_message_paging_num_msgs_per_page">Open chats faster by loading only the newest N messages. 0 loads everything. A load-all-messages button appears when older messages exist.</string>

    <string name="pref_title_compact_friendlist">Compact friend list</string>
    <string name="pref_description_compact_friendlist">Show more friends on screen by using smaller rows. Useful for long friend lists.</string>

    <string name="pref_title_compact_chatlist">Compact Chatlist</string>
    <string name="pref_description_compact_chatlist">Display Chatmessage more compact saving space</string>

    <string name="pref_title_notification_show_content">Show notification content</string>
    <string name="pref_description_notification_show_content">Show the sender and message text in notifications. Turn off to hide message content on your lock screen.</string>

    <string name="pref_title_use_push_service">Use push service</string>
    <string name="pref_description_use_push_service">Save battery and data by receiving wake-up pushes (Google FCM or UnifiedPush) instead of keeping Tox always connected.\n\nTrade-off: TRIfA talks to push servers over HTTPS, outside Tox, which can reveal when you get messages. Needs the Tox Push Message app installed. Enable only if you accept this.</string>

    <string name="pref_title_allow_push_server_ntfy">Allow ntfy.sh push server</string>
    <string name="pref_description_allow_push_server_ntfy">Use ntfy.sh for push delivery.\n\nWarning: ntfy.sh has no accounts or authentication. Anyone who learns your push token can subscribe and see when you receive pushes (timing metadata). Enable only if you accept this.</string>

    <string name="pref_title_allow_push_server_sunup">Allow Mozilla sunup push server</string>
    <string name="pref_description_allow_push_server_sunup">Use the Mozilla sunup server for push delivery.\n\nWarning: sunup has no accounts or authentication. Anyone who learns your push token can subscribe and see when you receive pushes (timing metadata). Enable only if you accept this.</string>

    <string name="pref_title_download_push_msg_app">Get the Tox Push Message app</string>

    <string name="pref_title_custom_bootstrap_nodes">Custom bootstrap node</string>

    <string name="pref_title_set_fps">Limit to 15 fps</string>
    <string name="pref_description_set_fps">Try to cap video at 15 fps. May crash on some phones; enable only if you need it.</string>

    <string name="pref_title_conference_show_system_messages">Conference system messages</string>
    <string name="pref_description_conference_show_system_messages">Show join/leave and other system notices in conference (group) chats.</string>

    <string name="pref_title_local_discovery_enabled">LAN discovery</string>
    <string name="pref_description_local_discovery_enabled">Find and use Tox nodes on your local network to bootstrap. Useful for LAN-only or offline setups.</string>

    <string name="pref_title_U_keep_nospam">Keep NoSpam (unsafe)</string>
    <string name="pref_description_U_keep_nospam">Keep the same NoSpam value fixed.\n\nUnsafe: this weakens spam protection. Only enable if you understand the consequences.</string>

    <string name="pref_title_allow_file_sharing_to_trifa_via_intent">Receive shared files</string>
    <string name="pref_description_allow_file_sharing_to_trifa_via_intent">Allow other apps to share files into TRIfA using the Android share menu.</string>

    <string name="pref_title_allow_open_encrypted_file_via_intent">Open encrypted files via other apps</string>
    <string name="pref_description_allow_open_encrypted_file_via_intent">Let other apps open files directly from the encrypted storage of TRIfA.\n\nWarning: a malicious app could use this to read other files in your encrypted storage. Enable only if you need it.</string>

    <string name="pref_title_allow_screen_off_in_audio_call">Allow screen off in calls</string>
    <string name="pref_description_allow_screen_off_in_audio_call">Let the screen turn off during a voice call to save battery. If calls misbehave when the screen turns off, disable this.</string>

    <string name="pref_title_speakerphone_tweak">Speakerphone fix</string>
    <string name="pref_description_speakerphone_tweak">Workaround for phones that do not switch to the speaker during a call. Enable only if you have that problem.</string>

    <string name="pref_title_X_zoom_incoming_video">Pinch-zoom incoming video (experimental)</string>
    <string name="pref_description_X_zoom_incoming_video">Allow pinch-to-zoom on the incoming video window. Experimental and not fully working yet.</string>

    <string name="pref_title_X_use_native_audio_play">Native Audio System</string>
    <string name="pref_description_X_use_native_audio_play">!! Experimental !!\nUse Native Audio to Play Sound</string>

    <string name="pref_title_X_battery_saving_mode">Battery saving mode (experimental)</string>
    <string name="pref_description_X_battery_saving_mode">Save some battery by letting Tox sleep between checks.\n\nTrade-off: messages send and arrive more slowly, and there may be other side effects. Experimental.</string>

    <string name="pref_title_X_misc_button_enabled">Quick-message button (experimental)</string>
    <string name="pref_description_X_misc_button_enabled">Show a button on the call screen that sends a fixed preset message. Experimental.</string>

    <string name="pref_title_X_tox_set_do_not_sync_av">Do not sync audio/video (experimental)</string>
    <string name="pref_description_X_tox_set_do_not_sync_av">Stop synchronizing audio and video streams. A last-resort workaround if video calls keep failing. Experimental.</string>

    <string name="pref_title_X_eac_delay_ms">Echo cancellation delay (experimental)</string>
    <string name="pref_description_X_eac_delay_ms">Delay (in ms) the acoustic echo canceller uses to line up speaker and microphone signals. Only change this if you have echo problems and know the right value for your device. Default: 80 ms.</string>

    <string name="pref_title_use_camera_x">Background remove</string>
    <string name="pref_description_use_camera_x">!! Experimental !!\nUse CameraX and Remove background in Video Calls\nThis might not work fully yet, please be careful and do not depend on this to work always!</string>

    <string name="pref_title_allow_enable_ngc_features">NGC - New Group Chats</string>
    <string name="pref_description_enable_ngc_features">!! Experimental !!\nThis is NOT fully working!!</string>

    <string name="pref_title_X_audio_play_buffer_custom">Audio playback buffer (experimental)</string>
    <string name="pref_description_X_audio_play_buffer_custom">Override the audio playback buffer size (in bytes) to fix choppy or delayed call audio. 0 uses the automatic default. Only change if you have playback problems.</string>

    <string name="pref_title_toxirc_muted_peers_01">Toxirc Bridge Muted Users</string>

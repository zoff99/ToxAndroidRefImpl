<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:background="@drawable/chat_canvas">
 <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:background="@drawable/chat_header_bg" app:contentInsetStart="0dp" app:contentInsetStartWithNavigation="0dp" app:contentInsetEnd="0dp" app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
  <include layout="@layout/chat_header"/>
 </androidx.appcompat.widget.Toolbar>

 <LinearLayout android:id="@+id/chat_search_bar" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/chat_composer_bg" android:visibility="gone">
  <ImageButton android:id="@+id/chat_search_close" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/chat_ic_close" app:tint="@color/chat_metadata" android:contentDescription="@android:string/cancel"/>
  <androidx.appcompat.widget.SearchView
            android:id="@+id/conf_search_view_messages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:focusable="false"
            app:iconifiedByDefault="false" android:layout_weight="1" android:queryBackground="@null" android:background="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
 </LinearLayout>
 <FrameLayout android:id="@+id/drawer_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

   <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <fragment android:id="@+id/ml_fragment" android:name="com.zoffcc.applications.trifa.ConferenceMessageListFragment" android:layout_width="match_parent" android:layout_height="match_parent" tools:layout="@layout/conference_message_list_layout"/>

   </FrameLayout>
   <TextView android:id="@+id/ml_friend_typing" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="3dp" android:background="@drawable/chat_composer_bg" android:textColor="@color/chat_accent" android:textSize="12sp" android:visibility="gone"/>
   <TextView android:id="@+id/ml_maintext" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
   <ImageView android:id="@+id/ml_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
   <ImageView android:id="@+id/ml_status_icon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
   <LinearLayout android:id="@+id/emoji_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal" android:background="@drawable/chat_composer_bg" android:padding="6dp">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:background="@drawable/chat_input_bg">
    <ImageButton android:id="@+id/insert_emoji" android:layout_width="42dp" android:layout_height="48dp" android:padding="10dp" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/chat_ic_smile" app:tint="@color/chat_metadata" android:contentDescription="@string/chat_emoji"/>
    <com.vanniktech.emoji.EmojiEditText android:id="@+id/ml_new_message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:maxLines="5" android:inputType="textMultiLine|textCapSentences" android:imeOptions="actionSend" android:background="@null" android:hint="@string/chat_input_hint" android:textColor="@color/chat_text" android:textColorHint="@color/chat_metadata" android:textSize="16sp"/>
   </LinearLayout>
   <ImageButton android:id="@+id/ml_button_01" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="6dp" android:padding="13dp" android:background="@drawable/chat_send_bg" android:onClick="send_message_onclick" app:srcCompat="@drawable/chat_ic_send" app:tint="@android:color/white" android:contentDescription="@string/chat_send"/>
  </LinearLayout>
  </LinearLayout>
 </FrameLayout>
</LinearLayout>

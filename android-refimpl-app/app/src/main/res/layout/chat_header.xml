<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/chat_header_bg" android:paddingEnd="2dp">
 <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="2dp" android:layout_marginEnd="8dp">
  <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/chat_avatar" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/chat_ic_person" android:scaleType="centerCrop" app:civ_fill_color="#348078" android:contentDescription="@string/chat_avatar"/>
  <ImageView android:id="@+id/chat_avatar_badge" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/chat_ic_group" android:visibility="gone"/>
 </FrameLayout>
 <LinearLayout android:id="@+id/chat_header_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:gravity="center_vertical">
  <TextView android:id="@+id/chat_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/chat_on_header" android:textSize="18sp" android:textStyle="bold"/>
  <TextView android:id="@+id/chat_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="@color/chat_on_header_secondary" android:textSize="12sp"/>
 </LinearLayout>
 <ImageButton android:id="@+id/ml_video_icon" android:layout_width="@dimen/chat_action_size" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:scaleType="fitCenter" app:srcCompat="@drawable/chat_ic_video" app:tint="@color/chat_on_header" android:contentDescription="@string/title_activity_calling"/>
 <ImageButton android:id="@+id/ml_phone_icon" android:layout_width="@dimen/chat_action_size" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:scaleType="fitCenter" app:srcCompat="@drawable/chat_ic_phone" app:tint="@color/chat_on_header" android:contentDescription="@string/title_activity_calling"/>
 <ImageButton android:id="@+id/chat_more" android:layout_width="@dimen/chat_action_size" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:scaleType="fitCenter" app:srcCompat="@drawable/chat_ic_more" app:tint="@color/chat_on_header" android:contentDescription="@string/chat_more_options"/>
</LinearLayout>

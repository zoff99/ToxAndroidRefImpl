<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificationbg"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:padding="12dp"
    android:background="?android:attr/colorBackground">

    <!-- Compact Clean Album Art Container (Reduced to 72dp for maximum text clearance) -->
    <ImageView
        android:id="@+id/status_bar_album_art"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:background="?android:attr/colorPrimaryDark"
        android:src="@drawable/i_emoji_google_1f601" />

    <!-- Action Buttons Block (Scaled down cleanly to exactly 40dp height) -->
    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/status_bar_album_art"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/status_bar_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Mute/Play"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/about_icon_google_play"
            android:tint="?android:attr/textColorPrimary" />

        <!-- Spacer ImageView for precise gap layout structuring -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="1dp"
            android:src="@android:color/transparent" />

        <ImageButton
            android:id="@+id/status_bar_stop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Stop"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/about_icon_instagram"
            android:tint="?android:attr/textColorPrimary" />

    </LinearLayout>

    <!-- Subdued, Elegant Divider Line (Anchored right above the optimized 40dp control bar) -->
    <ImageView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/buttons"
        android:layout_toEndOf="@id/status_bar_album_art"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/listDivider"
        android:alpha="0.4" />

    <!-- Metadata Content Block (Aligned to the parent end for maximum horizontal space) -->
    <LinearLayout
        android:id="@+id/textarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_above="@id/divider"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/status_bar_album_art"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- Modern Micro-typography for Time tracker -->
        <Chronometer
            android:id="@+id/status_bar_chrono2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/status_bar_track_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Track Name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee" />

        <TextView
            android:id="@+id/status_bar_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Artist Name"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>

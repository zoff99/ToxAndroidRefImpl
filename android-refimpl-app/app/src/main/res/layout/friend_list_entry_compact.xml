<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/swipe_reveal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/swipe_reveal_pin_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="16dp"
            android:src="@drawable/swipe_pin_icon"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/swipe_reveal_unpin_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="16dp"
            android:src="@drawable/swipe_unpin_icon"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/outside_friend_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/friend_line_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/f_avatar_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/circle_blue"
                app:civ_border_width="0dp" />

            <ImageView
                android:id="@+id/f_status_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:scaleType="centerInside"
                android:src="@drawable/circle_green" />

            <ImageView
                android:id="@+id/f_relay_icon"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="bottom|start"
                android:scaleType="centerInside"
                android:src="@drawable/circle_red"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/f_user_status_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:scaleType="centerInside"
                android:src="@drawable/circle_green" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/f_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/main_list_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/f_last_online_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:maxLines="1"
                    android:textColor="@color/main_list_metadata"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/f_status_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/main_list_metadata"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/f_unread_count"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/main_list_unread_badge"
                android:gravity="center"
                android:textColor="@color/main_list_badge_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/f_notification"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/circle_red" />
        </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="76dp"
            android:background="@color/main_list_divider" />
    </FrameLayout>
</FrameLayout>

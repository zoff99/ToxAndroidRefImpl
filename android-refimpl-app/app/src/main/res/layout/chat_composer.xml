<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/emoji_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:background="@color/chat_composer" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="6dp" android:paddingBottom="8dp">
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="50dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/chat_input_bg" android:paddingStart="3dp" android:paddingEnd="3dp">
  <ImageButton android:id="@+id/insert_emoji" android:layout_width="42dp" android:layout_height="48dp" android:padding="10dp" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/chat_ic_smile" app:tint="@color/chat_metadata" android:contentDescription="@string/chat_emoji"/>
  <com.vanniktech.emoji.EmojiEditText android:id="@+id/ml_new_message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:maxLines="5" android:inputType="textMultiLine|textCapSentences" android:imeOptions="flagNoPersonalizedLearning|actionSend" android:gravity="center_vertical" android:background="@null" android:hint="@string/chat_input_hint" android:textColor="@color/chat_text" android:textColorHint="@color/chat_metadata" android:textSize="16sp" android:paddingTop="8dp" android:paddingBottom="8dp"/>
  <ImageButton android:id="@+id/ml_button_01" android:layout_width="42dp" android:layout_height="48dp" android:padding="10dp" android:background="?attr/selectableItemBackgroundBorderless" android:onClick="send_message_onclick" app:srcCompat="@drawable/chat_ic_attach" app:tint="@color/chat_metadata" android:contentDescription="@string/chat_attach"/>
 </LinearLayout>
 <ImageButton android:id="@+id/ml_button_recaudio" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="6dp" android:padding="13dp" android:background="@drawable/chat_send_bg" app:srcCompat="@drawable/chat_ic_mic" app:tint="@android:color/white" android:contentDescription="@string/chat_record"/>
</LinearLayout>
